# Copy this file to `.env` and fill in values for local runs.
# Never commit `.env` — it is gitignored.
#
# In GitHub Actions, set the same keys as repository Secrets
# (Settings → Secrets and variables → Actions), then map them in the workflow.

# Sauce Demo — standard (valid) user
SAUCE_STANDARD_USERNAME=
SAUCE_STANDARD_PASSWORD=

# Sauce Demo — locked-out user
SAUCE_LOCKED_OUT_USERNAME=
SAUCE_LOCKED_OUT_PASSWORD=

# Sauce Demo — intentionally wrong password for negative login tests
SAUCE_INVALID_PASSWORD=
